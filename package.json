{
  "name": "william-lo-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && node scripts/prepare-sites-output.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:production": "node scripts/check-production-output.mjs",
    "performance": "npm run build && node scripts/check-lighthouse.mjs",
    "verify": "npm run format && npm run typecheck && npm run lint && npm run test && npm run build && npm run check:production && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "astro": "7.1.4",
    "motion": "12.43.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.0",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "lighthouse": "^13.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
